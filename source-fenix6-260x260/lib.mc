    function drawBackground(dc as Graphics.Dc, dx as Lang.Number, dy as Lang.Number) as Void {
        for (var i = 0; i < 16; i++) {
            dc.drawBitmap((i % 4) * 65 - dx, (i / 4).toNumber() * 65 - dy,
                          WatchUi.loadResource(self.pieces[i]));
        }
